# Required — TCP port the API server listens on
PORT=4000

# SMTP settings — used by the demo request email route
# For Gmail: host=smtp.gmail.com, port=587, user=your-address@gmail.com
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bidiisoftwares.1.ke@gmail.com
SMTP_PASS=your-gmail-app-password-here

# The company inbox that receives demo request emails
# Defaults to bidiisoftwares.1.ke@gmail.com if not set
CONTACT_EMAIL=bidiisoftwares.1.ke@gmail.com
